{
  "interface": "eth0",
  "promiscuous": true,
  "bpf_filter": "",
  "database_path": "edgesight.db",
  "listen_addr": "127.0.0.1:8080",
  "api_key": "",
  "syslog_enabled": false,
  "syslog_target": "udp://127.0.0.1:514",
  "plugins_enabled": [],
  "webhook_url": "",
  "csv_export_path": "edgesight_events.csv",
  "enrichment_keys": {
    "shodan": "",
    "virustotal": "",
    "censys": "",
    "abuseipdb": ""
  },
  "baseline_window": "5m",
  "anomaly_z_score": 3,
  "max_packet_size": 65535,
  "tui": false,
  "verbose": false
}
